* text=auto
.gitattributes text eol=lf
.gitignore text eol=lf
.editorconfig text eol=lf
*.md text eol=lf
*.json text eol=lf
*.js text eol=lf
*.mjs text eol=lf
*.ts text eol=lf
*.tsx text eol=lf
*.css text eol=lf
*.html text eol=lf
*.rs text eol=lf
*.toml text eol=lf
*.yml text eol=lf
*.yaml text eol=lf
*.sh text eol=lf
*.py text eol=lf
*.svg text eol=lf
*.ps1 text eol=crlf
*.cmd text eol=crlf
